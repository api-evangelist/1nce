          "id": "1c14926f-01c1-45a6-acca-269c6d9e4fe3",
          "name": "Get SIM Connectivity",
          "request": {
            "name": "Get SIM Connectivity",
            "description": {
              "content": "Retrieve connectivity information and cell tower of a device with a given SIM. The API call returns valid information when the 1NCE SIM is attached to a 2G/3G network only.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "sims",
                ":iccid",
                "connectivity_info"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "subscriber",
                  "value": "true",
                  "description": "Flag indicating if the subscriber information should be retrieved. Default value is true."
                },
                {
                  "disabled": false,
                  "key": "ussd",
                  "value": "false",
                  "description": "Flag for retrieving the USSD connectivity info. Default value is false."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "iccid",
                  "description": "(Required) The iccid of the SIM in question."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
