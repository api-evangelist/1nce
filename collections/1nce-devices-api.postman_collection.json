          "name": "Create Action Request On Specific LwM2M Device.",
          "request": {
            "name": "Create Action Request On Specific LwM2M Device.",
            "description": {
              "content": "Initiate LwM2M action like read, write, execute on specific device. It has to be connected to 1NCE LwM2M endpoint to invoke this event.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "devices",
                ":deviceId",
                "actions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "deviceId",
                  "description": "(Required) The unique device ID which identifies each 1NCE SIM. Can be obtained from the Get All Devices API query. For 1NCE SIMS the device ID is equal to its iccid."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
