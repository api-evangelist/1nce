          "id": "2c3c6c92-2236-4ee4-a20f-cca51411c131",
          "name": "Create SIM Extension",
          "request": {
            "name": "Create SIM Extension",
            "description": {
              "content": "Trigger the SIM extension for one or more SIM cards to extend their activation period and renew their quota (data and SMS). An invoice is automatically triggered depending on the chosen payment method.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "sims",
                "extension"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "payment_method",
                  "value": "banktransfer",
                  "description": "Optional payment method selection between creditcard, banktransfer, monthly invoice or boleto. If the parameter is left empty or is invalid, banktransfer is used as default for the SIM extension process. To use creditcard please save your credit card details in the customer portal via \"account\"."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iccids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"productId\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
