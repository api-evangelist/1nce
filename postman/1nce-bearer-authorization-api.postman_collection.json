                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: basic",
                        "key": "Authorization",
                        "value": "Basic <credentials>"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"grant_type\": \"client_credentials\"\n}",
                      "options": {
                        "raw": {
